# Copier ce fichier en .env (non versionne) puis remplacer les valeurs.
# docker compose lit automatiquement .env.

# Cle partagee entre le backend Spring Boot et les routes /admin de l'API Zero Trust.
ADMIN_API_KEY=change-me

# Duree de l'attaque de demonstration (docker compose --profile attack run --rm attacker).
ATTACK_SECONDS=20
